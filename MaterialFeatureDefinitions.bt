enum <uint> EMaterialTextureBindingMask {
    kTextureBind_AsBindless = 1,
    kTextureBind_AsMultiTexCoord = 2,
    kTextureBind_BindTextureSizeParams = 4,
    kTextureBind_IgnoreTexture = 8
};
enum <uint> EMaterialLayeredTextureBindingMask {
    kLayeredBind_AsMultiTexCoord = 1,
    kLayeredBind_IgnoreTexture0 = 2,
    kLayeredBind_IgnoreTexture1 = 4,
    // Despite the name, setting this bit binds BlendTexture.
    kLayeredBind_IgnoreBlendTexture = 8,
    kLayeredBind_BindTexture0SizeParams = 16,
    kLayeredBind_BindTexture1SizeParams = 32,
    kLayeredBind_BindBlendTextureSizeParams = 64
};
enum <uint> EMaterialBakedProbeTextureBindingMask {
    kBakedProbeBind_IgnoreTransform = 1
};

