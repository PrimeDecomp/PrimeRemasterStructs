#ifndef _CMAYASPLINE
#define _CMAYASPLINE

#include "Common.bt"
#include "CVector2f.bt"

// Mode names are inferred from runtime behavior.
typedef enum <uchar> {
  MayaTangentLinear = 0,
  MayaTangentFlat = 1,
  MayaTangentSmooth = 2,
  MayaTangentStep = 3,
  MayaTangentAdaptive = 4,
  MayaTangentFixed = 5,
} EMayaSplineTangent;

typedef enum <uchar> {
  MayaInfinityConstant = 0,
  MayaInfinityLinear = 1,
  MayaInfinityCycle = 2,
  MayaInfinityCycleRelative = 3,
  MayaInfinityOscillate = 4,
} EMayaSplineInfinity;

typedef enum <uchar> {
  MayaAmplitudeUnclamped = 0,
  MayaAmplitudeClamp = 1,
  MayaAmplitudeWrap = 2,
} EMayaSplineClamp;

typedef struct CMayaSplineKnot {
  float time;
  float value;
  EMayaSplineTangent tangentTypeA; // incoming
  EMayaSplineTangent tangentTypeB; // outgoing

  if (tangentTypeA == 5) {
    CVector2f tangentA;
  }

  if (tangentTypeB == 5) {
    CVector2f tangentB;
  }
} CMayaSplineKnot;

typedef struct CMayaSpline {
  uint knotCount;
  if (knotCount > 0) {
    CMayaSplineKnot knots[knotCount] <optimize = false>;
  }
  float minAmplitude;
  float maxAmplitude;
  EMayaSplineInfinity preInfinity;
  EMayaSplineInfinity postInfinity;
  EMayaSplineClamp clampMode;
} CMayaSpline;

#endif// _CMAYASPLINE
