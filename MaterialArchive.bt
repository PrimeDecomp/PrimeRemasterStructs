#ifndef _MATERIALARCHIVE
#define _MATERIALARCHIVE
#include "ShaderNVN.bt"
#include "ShaderDXBC.bt"
#include "MaterialFeatureDefinitions.bt"

struct SBufferTOCEntry {
    uint offset; // Relative to shaderSourceCount, after the TOC.
    uint size;
};

// Local option indices, least-significant bit first.
// Each uses max(1, ceil(log2(optionCount))) bits.
struct CPermutation {
  uint64 value[2]; // low word first; no alignment padding
};
#include "MaterialRuntime.bt"

// Comments give runtime technique indices.
enum <char> EMaterialTechnique {
    kMT_None = 'x', // 0
    kMT_DepthOnly = 'z', // 1
    kMT_DeferredGBuffer = 'g', // 2
    kMT_DeferredInstance = 'i', // 3
    kMT_ForwardRender = 'f', // 4
    kMT_ParticleTechniqueSprite = 's', // 5
    kMT_ParticleTechniqueSwoosh = 'w', // 6
    kMT_ParticleTechniqueModel = 'm', // 7
    kMT_ThermalHot = 'h', // 8
    kMT_XRay = 'r', // 9
    kMT_ParticleTechniqueModel_XRay = 'a', // 10
    kMT_ParticleTechniqueSprite_XRay = 'y', // 11
    kMT_ParticleTechniqueSwoosh_XRay = 'b' // 12
};

struct CShaderIdentifier {
    EMaterialTechnique matTechnique;
    CPermutation perm;
};

struct SShaderTOCEntry {
    CShaderIdentifier identifier;
    uint offset; // Same origin as SBufferTOCEntry.
    uint size; // Full SShaderImportDesc size.
};

struct SMaterialTOCEntry {
    GUID guid;
    uint materialHash;
    uint nameLen;
    char name[nameLen];
    ushort unk2;
    uint shaderEntryCount;
    SShaderTOCEntry shaderEntries[shaderEntryCount];    
    SBufferTOCEntry bufferToc; // Length-prefixed material data, excluding its header.
};

struct SShaderSource(uint isNVN, uint isSDX) {
    uchar state;
    uint strLen;
    if (strLen)
        char str[strLen]; 
    uint dataLen;
    if (isNVN && dataLen) {
        SNVNShaderBinary data(dataLen);
    } else if (isSDX && dataLen) {
        SSDXShaderBinary data(dataLen);
    } else if (dataLen) {
        uchar data[dataLen];
    }
};

struct CShaderDefines {
    struct Name {
        if (isDKCTF)
        {
            CString str1;
        }
        else
        {
            CStringFixed str1;
        }
    };

    uint namesCount;
    if (namesCount)
        Name names[namesCount] <optimize = false>;
    uint unk;
};

struct CShaderVariable {
    ushort packed;
    // SNVN type 0 indexes SUniform; type 1 indexes SResource_NVN.
    local uint valid = packed != 0xffff;
    local uint type = packed & 1;
    local uint index = packed >> 1;
};
struct SShaderImportDesc(uint isNVN) {
    if (!isDKCTF)
    {
        CShaderIdentifier ident;
    }
    uint64 shaderID;
    int vertexProgramIndex;
    if (!isDKCTF)
    {
        int pixelProgramIndex;
    }
    else
    {
        int fragProgramIndex;
    }
    int geomProgramIndex;
    if (!isDKCTF)
    {
        int computeProgramIndex;
    }
    int unk;
    CShaderDefines defines;
    uint dataSize;
    if (isNVN && dataSize) {
        union {
            uchar raw[dataSize];
            SNVNReflection decoded(dataSize);
        } metadata;
    } else if (dataSize) {
        uchar metadata[dataSize];
    }
};

// Postfix boolean expressions.
enum <uint> EBooleanOpcode {
    kBool_True = 0, kBool_False = 1, kBool_Equal = 2, kBool_Xor = 3,
    kBool_Not = 4, kBool_Implies = 5, kBool_And = 6, kBool_Or = 7,
    kBool_Identifier = 0xffffffff
};
struct SExpression {
    EBooleanOpcode opcode;
    uint operand; // Identifier index; unused for operators.
};

struct CBooleanExpressionEvaluator {
    uint expressionCount;
    SExpression expressions[expressionCount];
};

struct SSimpleFeatureInstanceInternalOptionRequirement {
    uint optionMask; // Clear these definition-option bits when a nonempty expression is false.
    CBooleanExpressionEvaluator evaluator;
};

struct SSimpleFeatureInstanceShaderBinding {
    CStringFixed semantic;
    CStringFixed binding;
};

struct SSimpleFeatureInstanceInternalOption {
    uint definitionOption;
    CShaderDefines shaderDefines;
    uint bindingCount;
    if (bindingCount) {
        SSimpleFeatureInstanceShaderBinding binding[bindingCount] <optimize = false>;
    }
};

struct IFeatureInstance;
struct CFeatureSet {
    uint count;
    IFeatureInstance features[count] <optimize = false>;
    CBooleanExpressionEvaluator evaluator;
};

struct CSimpleFeatureInstance {
    union {
        FourCC id;
        EMaterialFeatureDefinition type;
    } definition;
    uint dataIdCount;
    Assert(dataIdCount <= 16);
    FourCC dataIds[dataIdCount];
    // Expression i sets bit (i & 31); empty expressions are false.
    uint flagExpressionCount;
    CBooleanExpressionEvaluator flagExpressions[flagExpressionCount] <optimize = false>;
    uint internalOptionCount;
    SSimpleFeatureInstanceInternalOption internalOption[internalOptionCount] <optimize = false>;
    uint allowedOptions <format=hex>; // Definition-option mask.
    uint optionMapCount;
    Assert(optionMapCount <= 32);
    uint optionMap[optionMapCount]; // Definition -> local option; 0xffffffff = absent.
    uint optionRequirementCount;
    if (optionRequirementCount)
        SSimpleFeatureInstanceInternalOptionRequirement optionRequirements[optionRequirementCount] <optimize = false>;
};

struct SCompositeFeatureInstanceInternalOptionRequirement {
    uint optionMask; // Clear these local-option bits when the expression is false.
    CBooleanExpressionEvaluator eval;
};

struct SCompositeFeatureInstanceInternalOption {
    CStringFixed name;
    CPermutation perm;
    CShaderDefines defines;
};

struct SCompositeFeatureInstanceArgument {
    CStringFixed name;
    CBooleanExpressionEvaluator evaluator;
};

struct CCompositeFeatureInstance {
    CFeatureSet subSet;
    uint argumentCount;
    if (argumentCount) {
        SCompositeFeatureInstanceArgument arguments[argumentCount] <optimize = false>;
    }
   uint bindArgumentCount;
   if (bindArgumentCount) {
       SCompositeFeatureInstanceArgument bindArguments[bindArgumentCount] <optimize = false>;
   }

   uint optionCount;
   SCompositeFeatureInstanceInternalOption options[optionCount] <optimize = false>;
    uint optionRequirementsCount;
   SCompositeFeatureInstanceInternalOptionRequirement optionRequirements[optionRequirementsCount] <optimize = false>;
};

struct IFeatureInstance;
struct CExplicitCompositeFeatureInstance;
struct CExplicitCompositeFeatureInstance {
    CCompositeFeatureInstance base;
    IFeatureInstance selector;
};

struct IFeatureInstance {
    uint type;
    CStringFixed name;
    uint dataOrigin;
    uint optionCount; // Permutation width = max(1, ceil(log2(optionCount))).
    Assert(optionCount > 0);
    switch(type) {
        case 0:
            CSimpleFeatureInstance simple <optimize = false>;
        break;
        case 1:
            CCompositeFeatureInstance composite <optimize = false>;
        break;
        case 2:
            CExplicitCompositeFeatureInstance explicitComposite <optimize = false>;
        break;
    }
};

struct SDepthModeState {
    uint enabled;
    uint compareFunction; // 0 never, 1 always, 2 !=, 3 <, 4 <=, 5 ==, 6 >=, 7 >
    uint writeEnabled; // 1 = enabled; writes without a depth test use Always.
};

struct SStencilModeState {
    uint enabled;
    uint compareFunction;
    uint operations[3]; // EStencilFunction; order unknown
};

// Explicit factors and equations take precedence over preset.
struct STargetBlendMode {
    int preset; // EBlendMode; -1 = explicit
    uint colorEquation;
    uint colorSource;
    uint colorDestination;
    uint alphaEquation;
    uint alphaSource;
    uint alphaDestination;
    float constantColor[4];
    int logicOp; // -1 = unused
};

struct SBlendState {
    // 0 preserves state; 0xffffffff applies targets[0] to every target.
    uint targetMask <format=hex>;
    uint targetCount;
    if (targetCount)
        STargetBlendMode targets[targetCount];
};

struct SGraphicsScissorRect {
    int coordinates[4];
};

// Fields are serialized in this order, regardless of flag-bit order.
struct CGraphicsState {
    uint flags <format=hex>;
    if (flags & (1 << 1)) uchar cullMode; // 0 none, 1 front, 2 back
    if (flags & (1 << 2)) uchar frontFace; // 0 CCW, 1 CW
    if (flags & (1 << 3)) SDepthModeState depth;
    if (flags & (1 << 12)) float depthBias[3];
    if (flags & (1 << 4)) SStencilModeState stencil;
    if (flags & (1 << 11)) uchar stencilMasks[3];
    if (flags & (1 << 13)) uchar alphaToCoverage;
    if (flags & (1 << 0)) SBlendState blend;
    if (flags & (1 << 10)) uchar colorMask[2]; // RGBA write bits, target mask
    if (flags & (1 << 5)) uint fillMode; // 0 line, otherwise fill
    if (flags & (1 << 6)) float clearColor[4];
    if (flags & (1 << 7)) float clearDepth;
    if (flags & (1 << 8)) uint clearStencil;
    if (flags & (1 << 14)) uint rasterControl[2];
    if (flags & (1 << 9)) {
        uint scissorCount;
        if (scissorCount) SGraphicsScissorRect scissors[scissorCount];
    }
    if (flags & (1 << 15)) float lineWidth;
};

struct SOverrideState {
    // An empty expression is unconditional.
    CBooleanExpressionEvaluator evaluator;
    CGraphicsState state;  
};
struct SFeaturedMaterialTechnique {
    uchar present;
    if (present) {
        CFeatureSet featureSet;
        CGraphicsState state;
        uint overrideStateCount;
        if (overrideStateCount)
            SOverrideState overrideStates[overrideStateCount] <optimize = false>;
    }
};

struct SMaterialImportDesc(uint isNVN) {
    if (!isDKCTF)
    {
        GUID guid;
        uint shaderHash;
        CStringFixed name;
    }
    else
    {
        FourCC name;
    }
    ushort unk2;
    uint shaderImportCount;
    SShaderImportDesc shaderImportDescs(isNVN)[shaderImportCount] <optimize = false>;
    uint dataSize;
    if (dataSize) {
        local uint64 dataEnd = FTell() + dataSize;
        union {
            if (!isDKCTF) {
                struct {
                    // Indexed by runtime technique, including absent entries.
                    SFeaturedMaterialTechnique techniques[16] <optimize = false>;
                    Assert(FTell() == dataEnd, "Featured material metadata size mismatch");
                } decoded;
            }
            uchar raw[dataSize];
        } data;
    }
};

struct MaterialBackend {
    ChunkDescriptor chunk;
    local uint isNVN = !isDKCTF && chunk.id == "SNVN";
    local uint isSDX = !isDKCTF && chunk.id == "SDX ";
    local uint64 start <format=hex, hidden=true> = FTell();
    uint flags;
    if ((flags & 1) != 0 || (isDKCTF && flags != 0)) {
        uint tocSize;
        uint bufferEntryCount;
        SBufferTOCEntry bufferEntries[bufferEntryCount];
        if (!isDKCTF)
        {
            uint materialEntryCount;
            SMaterialTOCEntry materialEntries[materialEntryCount] <optimize = false>;
        }
    }
    
    if (!isDKCTF)
    {
	    uint shaderSourceCount;
	    SShaderSource shaderSources(isNVN, isSDX)[shaderSourceCount]  <optimize = false>;
	}

	uint materialImportDescCount;
	SMaterialImportDesc materialImportDescs(isNVN)[materialImportDescCount] <optimize = false>;

    if ((FTell() - start) != chunk.size) {
        char data[chunk.size - (FTell() - start)];
    }
};

struct MaterialArchive(uint64 size) {
    local uint64 start <format=hex, hidden=true> = FTell();
    while (FTell() < start + size) {
        MaterialBackend backend;
    }
};

struct SMaterialMetaData(uint64 fileStart) {
    uint32 count;
    uint32 version;
    uint32 compressedSize;
    uint32 decompressedSize;
    uint32 fileOffset;

    local uint64 pos <format=hex, hidden=true> = FTell();
    FSeek(fileStart + fileOffset);
    byte zlibData[compressedSize];
    FSeek(pos);
};

#endif// _MATERIALARCHIVE
