#ifndef _CMATERIALINSTANCERESOURCE
#define _CMATERIALINSTANCERESOURCE

#include "CChunkDescriptor.bt"
#include "NGraphicsMaterial.bt"

int getCountFromBits(int b) {
  local int count = 0;

  while (b > 0) {
    count += (b & 1);
    b >>= 1;
  }

  return count;
}
typedef struct {
  FourCC type;
  FourCC id;
  uchar unk1;
  uchar unk2;
} CVariableDesc <name=(Str("%s %s", type, id))>;

typedef struct {
  FourCC id;
  uchar type;

  switch (type) {
  case 2:
    int unk;
    break;
  case 3:
  case 4:
  case 12:
    CColor4f color;
    break;
  case 5:
  case 6:
  case 7:
  case 8:
    GUID texture;
    STextureUsageInfo textureUsage;
    break;
  case 10:
    CVector4i unk;
    break;
  }

} CMaterialInstanceData; // named from CMaterialInstanceDataBuilder, not guaranteed to be accurate
typedef struct {
  ChunkDescriptor chunk;
  GUID guid1;
  GUID guid2;
  if (form.readerVersion == 37) {
    uchar unkByte;
    uchar unkByte2;
    uint unkInt;
    uint unkInt2;
    uint variableDescCount;
    CVariableDesc variableDescs[variableDescCount];
    uchar unkByte3;

    if (unkByte3) {
        struct {
            ubyte packedCount;
            local int actualCount = getCountFromBits(packedCount);
            if (actualCount > 0) {
                struct {
                    uint unkCount;
                    struct {
                        float unk1;
                        float unk2;
                        uchar unk3;
                        uchar unk4;
                        if (unk3 == 5) {
                            float unk5;
                            float unk6;
                        } 
                        if (unk4 == 5) {
                            float unk7;
                            float unk8;
                        }
                    } unkData[unkCount]<optimize = false>;
                    
                    float unk1;
                    float unk2;
                    uchar unk3;
                    uchar unk4;
                    uchar unk5;
                } unkData[actualCount] <optimize = false>;
            }
        } unkData[unkByte3] <optimize = false>;
    }

    ubyte unk4;

    uint propertyCount;
    CMaterialInstanceData data[propertyCount]<optimize = false>;
    uint unkFccCount;
    struct {
        FourCC fcc;
     } unkFourCC[unkFccCount];
  } else {
    uint unk1;
    uchar unk2;
    uint unk3;
    uint unk4;
  }
  //  uint variableDescCount;
  //  CVariableDesc varibleDescs[variableDescCount];
  //  if (form.readerVersion == 37) {
  //    uchar unk5;
  //    uchar unk6;
  //    uint unk7;
  //  } else {
  //    uint dataCount;
  //  }

} CMaterialInstanceResource;

#endif// _CMATERIALINSTANCERESOURCE
